# Copy to .env and fill in locally. Never commit .env.
# Local `python3 build.py` does not read this file; it is for hosted deploys
# and for documenting the private/public split.

# Shareable site (default). No Basic Auth. HTML is public-mode (handles stripped).
DASHBOARD_MODE=public

# Private site — all three are required together. The edge function fail-closes
# with HTTP 503 if user/password are missing. Build script also refuses private
# without these names set.
# DASHBOARD_MODE=private
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=

# scripts/publish.sh (CLI deploy; not used by a fresh clone)
# SOURCE_DATA_DIR=
# X_FOLLOWERS_DIR=
# NETLIFY_SITE_ID_PUBLIC=
# NETLIFY_SITE_ID_PRIVATE=
# NETLIFY_AUTH_TOKEN=

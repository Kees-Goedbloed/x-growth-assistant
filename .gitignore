# Generated dashboard (Netlify publish dir is dist/)
index.html
index*.html
dist/

# Secrets and local Netlify state
.env
.env.*
!.env.example
.netlify/
*.pem
*.key
*.p12
*.pfx

# Local setup (scripts/setup.sh)
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Screenshots (except the committed OG title card)
*.png
!assets/*.png
screenshots/

# Built owner avatar — never commit the real photo
assets/avatar.jpg
assets/avatar.jpeg
assets/avatar.webp
assets/avatar.png
.avatar-cache/
**/.avatar-cache/

# Regenerated by test-fixtures/make_fixtures.py
test-fixtures/data/

# Real dashboard inputs — never commit.
# Must be data/** not data/*. Un-ignoring directories with !data/**/ would
# otherwise re-include nested files (followers/, posts/, analytics-csv/,
# research/) that data/* does not match, so `git add -A` would stage them.
data/**
!data/**/
!data/**/.gitkeep
!data/**/*.example.*
